---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.tsx';
---
<Base title="Techtious Labs — Cloud Intelligence Suite" description="Three autonomous agents that deploy inside your cloud — eliminating waste, catching drift, and keeping your platform stable.">

  <Nav client:load />

  <!-- ═══════ HERO ═══════ -->
  <section style="position:relative;overflow:hidden;background:#FAFAF8;padding-bottom:96px;">
    <div class="dot-grid" style="position:absolute;inset:0;opacity:.42;pointer-events:none;"></div>
    <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#0891B2,#06B6D4 40%,transparent);"></div>

    <div style="max-width:1440px;margin:0 auto;padding:88px 72px 0;position:relative;">
      <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:28px;">
        <div style="width:20px;height:1px;background:#0891B2;"></div>
        <span style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.14em;color:#0891B2;">Cloud Intelligence Product Suite</span>
      </div>

      <div style="display:grid;grid-template-columns:1fr 440px;gap:80px;align-items:start;">
        <div>
          <h1 style="font-family:'Cormorant Garamond',serif;font-size:80px;font-weight:600;line-height:1.03;letter-spacing:-.025em;color:#0B1E30;margin-bottom:28px;">
            The Cloud<br>Intelligence <em style="font-style:italic;color:#0891B2;">Suite</em>
          </h1>
          <p style="font-size:17px;font-weight:300;line-height:1.72;color:#5A7080;max-width:520px;margin-bottom:20px;">
            Three autonomous agents that deploy directly inside your cloud — eliminating waste, catching drift, and keeping your platform stable. Automatically, continuously, without leaving your environment.
          </p>
          <p style="font-size:14px;font-weight:400;line-height:1.65;color:#0891B2;max-width:460px;margin-bottom:44px;display:flex;align-items:center;gap:8px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="#0891B2" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Runs inside your AWS, GCP or Azure account. Zero data egress. You stay in control.
          </p>
          <div style="display:flex;gap:14px;align-items:center;margin-bottom:60px;">
            <button style="background:#0891B2;color:#FAFAF8;font-size:14px;font-weight:500;padding:15px 36px;border:none;border-radius:5px;cursor:pointer;letter-spacing:.02em;">Explore the Suite</button>
            <a style="font-size:14px;font-weight:500;color:#0891B2;text-decoration:none;display:flex;align-items:center;gap:6px;cursor:pointer;">See how agents deploy <span>→</span></a>
          </div>

          <div>
            <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:#A0B8C8;margin-bottom:14px;">Agent Suite</div>
            <div style="display:flex;flex-wrap:wrap;gap:10px;">
              <div style="display:flex;align-items:center;gap:8px;padding:8px 16px;background:#fff;border:1px solid #C8D8E4;border-radius:40px;">
                <div style="width:7px;height:7px;background:#10B981;border-radius:50%;"></div>
                <span style="font-size:12.5px;font-weight:500;color:#0B1E30;">Optix AI — FinOps &amp; K8s Cost</span>
                <span style="font-size:10px;font-weight:600;color:#10B981;background:#ECFDF5;padding:2px 7px;border-radius:10px;text-transform:uppercase;letter-spacing:.06em;">Live</span>
              </div>
              <div style="display:flex;align-items:center;gap:8px;padding:8px 16px;background:#fff;border:1px solid #C8D8E4;border-radius:40px;">
                <div style="width:7px;height:7px;background:#F59E0B;border-radius:50%;"></div>
                <span style="font-size:12.5px;font-weight:500;color:#0B1E30;">SRE Intelligence — Logs &amp; Stability</span>
                <span style="font-size:10px;font-weight:600;color:#D97706;background:#FFFBEB;padding:2px 7px;border-radius:10px;text-transform:uppercase;letter-spacing:.06em;">Beta</span>
              </div>
              <div style="display:flex;align-items:center;gap:8px;padding:8px 16px;background:#fff;border:1px solid #C8D8E4;border-radius:40px;">
                <div style="width:7px;height:7px;background:#8B9EB0;border-radius:50%;"></div>
                <span style="font-size:12.5px;font-weight:500;color:#0B1E30;">DriftGuard — Environment Sync</span>
                <span style="font-size:10px;font-weight:600;color:#64748B;background:#F1F5F9;padding:2px 7px;border-radius:10px;text-transform:uppercase;letter-spacing:.06em;">Soon</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Architecture visual -->
        <div>
          <div style="background:#fff;border:1px solid #DDE8F0;border-radius:14px;padding:28px;box-shadow:0 2px 16px rgba(11,30,48,.06);">
            <div style="font-size:10.5px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:#8AA0B0;margin-bottom:20px;">Your Cloud Environment</div>
            <div style="display:flex;gap:8px;margin-bottom:20px;">
              <div style="flex:1;padding:7px 10px;background:#F0F7FF;border:1px solid #DBEAFE;border-radius:6px;text-align:center;font-size:11.5px;font-weight:500;color:#3B82F6;">AWS</div>
              <div style="flex:1;padding:7px 10px;background:#F0FDF4;border:1px solid #BBF7D0;border-radius:6px;text-align:center;font-size:11.5px;font-weight:500;color:#16A34A;">GCP</div>
              <div style="flex:1;padding:7px 10px;background:#FFF7ED;border:1px solid #FED7AA;border-radius:6px;text-align:center;font-size:11.5px;font-weight:500;color:#EA580C;">Azure</div>
            </div>
            <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px;">
              <!-- Optix AI -->
              <div style="border:1.5px solid #06B6D4;border-radius:10px;padding:14px 16px;background:linear-gradient(135deg,#F0FBFF,#FAFAF8);">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                  <div style="display:flex;align-items:center;gap:8px;">
                    <div style="width:28px;height:28px;background:linear-gradient(135deg,#0891B2,#06B6D4);border-radius:7px;display:flex;align-items:center;justify-content:center;">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M12 2L9 9l-7 3 7 3 3 7 3-7 7-3-7-3z" fill="#fff"/></svg>
                    </div>
                    <span style="font-family:'Cormorant Garamond',serif;font-size:15px;font-weight:600;color:#0B1E30;">Optix AI</span>
                  </div>
                  <div style="display:flex;align-items:center;gap:5px;">
                    <div style="width:6px;height:6px;background:#10B981;border-radius:50%;animation:pulse 2s ease infinite;"></div>
                    <span style="font-size:10.5px;color:#10B981;font-weight:500;">Active</span>
                  </div>
                </div>
                <div style="display:flex;gap:8px;">
                  <div style="flex:1;background:rgba(8,145,178,.08);border-radius:6px;padding:8px 10px;">
                    <div style="font-size:10px;color:#5A8A9E;margin-bottom:2px;">Cloud Waste</div>
                    <div style="font-size:16px;font-weight:600;color:#0891B2;font-family:'Cormorant Garamond',serif;">-43%</div>
                  </div>
                  <div style="flex:1;background:rgba(8,145,178,.08);border-radius:6px;padding:8px 10px;">
                    <div style="font-size:10px;color:#5A8A9E;margin-bottom:2px;">K8s Savings</div>
                    <div style="font-size:16px;font-weight:600;color:#0891B2;font-family:'Cormorant Garamond',serif;">$18K/mo</div>
                  </div>
                </div>
              </div>
              <!-- SRE Intelligence -->
              <div style="border:1.5px solid #F59E0B;border-radius:10px;padding:14px 16px;background:linear-gradient(135deg,#FFFDF0,#FAFAF8);">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                  <div style="display:flex;align-items:center;gap:8px;">
                    <div style="width:28px;height:28px;background:linear-gradient(135deg,#D97706,#F59E0B);border-radius:7px;display:flex;align-items:center;justify-content:center;">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="#fff" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="#fff"/></svg>
                    </div>
                    <span style="font-family:'Cormorant Garamond',serif;font-size:15px;font-weight:600;color:#0B1E30;">SRE Intelligence</span>
                  </div>
                  <div style="display:flex;align-items:center;gap:5px;">
                    <div style="width:6px;height:6px;background:#F59E0B;border-radius:50%;"></div>
                    <span style="font-size:10.5px;color:#D97706;font-weight:500;">Beta</span>
                  </div>
                </div>
                <div style="font-size:12px;color:#6A7E8A;font-weight:300;">Log anomaly detection · Platform stability · SLO tracking</div>
              </div>
              <!-- DriftGuard -->
              <div style="border:1.5px dashed #C8D8E4;border-radius:10px;padding:14px 16px;background:#F8FAFB;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                  <div style="display:flex;align-items:center;gap:8px;">
                    <div style="width:28px;height:28px;background:#DDE8F0;border-radius:7px;display:flex;align-items:center;justify-content:center;">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><polyline points="17 1 21 5 17 9" stroke="#8AA0B0" stroke-width="2"/><path d="M3 11V9a4 4 0 0 1 4-4h14" stroke="#8AA0B0" stroke-width="2"/><polyline points="7 23 3 19 7 15" stroke="#8AA0B0" stroke-width="2"/><path d="M21 13v2a4 4 0 0 1-4 4H3" stroke="#8AA0B0" stroke-width="2"/></svg>
                    </div>
                    <span style="font-family:'Cormorant Garamond',serif;font-size:15px;font-weight:600;color:#8AA0B0;">DriftGuard</span>
                  </div>
                  <span style="font-size:10.5px;color:#8AA0B0;font-weight:500;">Coming Soon</span>
                </div>
              </div>
            </div>
            <div style="padding:12px 14px;background:#F4F7FA;border-radius:8px;display:flex;align-items:center;gap:10px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="#0891B2" stroke-width="1.8"/></svg>
              <span style="font-size:11.5px;color:#5A7080;font-weight:300;">All agents run inside <strong style="font-weight:500;color:#0B1E30;">your</strong> cloud account. Zero data egress.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ PRODUCT SUITE ═══════ -->
  <section style="background:#fff;padding:96px 0;">
    <div style="max-width:1440px;margin:0 auto;padding:0 72px;">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:56px;">
        <div>
          <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:18px;">
            <div style="width:20px;height:1px;background:#0891B2;"></div>
            <span style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.14em;color:#0891B2;">Agent Suite</span>
          </div>
          <h2 style="font-family:'Cormorant Garamond',serif;font-size:52px;font-weight:600;letter-spacing:-.02em;color:#0B1E30;line-height:1.08;max-width:600px;">A growing suite of cloud intelligence agents</h2>
        </div>
        <p style="font-size:14px;font-weight:300;line-height:1.7;color:#5A7080;max-width:320px;text-align:right;padding-bottom:6px;">Start with one agent. Each deploys in minutes into your existing cloud — no rip-and-replace required.</p>
      </div>

      <!-- Optix AI full card -->
      <div style="border:1px solid #DDE8F0;border-radius:16px;overflow:hidden;margin-bottom:24px;background:#FAFAF8;">
        <div style="display:grid;grid-template-columns:1fr 400px;">
          <div style="padding:48px;border-right:1px solid #E8EEF6;">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:28px;">
              <div style="width:44px;height:44px;background:linear-gradient(135deg,#0891B2,#06B6D4);border-radius:11px;display:flex;align-items:center;justify-content:center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2L9 9l-7 3 7 3 3 7 3-7 7-3-7-3z" fill="#fff"/></svg>
              </div>
              <div>
                <div style="font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:700;color:#0B1E30;line-height:1;">Optix AI</div>
                <div style="font-size:12px;color:#8AA0B0;font-weight:300;">FinOps + Kubernetes Cost Intelligence</div>
              </div>
              <div style="margin-left:auto;display:flex;align-items:center;gap:6px;background:#ECFDF5;border:1px solid #A7F3D0;border-radius:20px;padding:5px 12px;">
                <div style="width:6px;height:6px;background:#10B981;border-radius:50%;animation:pulse 2s ease infinite;"></div>
                <span style="font-size:11px;font-weight:600;color:#059669;text-transform:uppercase;letter-spacing:.06em;">Live</span>
              </div>
            </div>
            <p style="font-size:15px;font-weight:300;line-height:1.75;color:#5A7080;margin-bottom:32px;max-width:480px;">One agent. Full visibility into cloud waste across your entire estate — and inside your Kubernetes clusters. It detects, recommends, and auto-remediates continuously.</p>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:36px;">
              {['Cloud cost anomaly detection','Kubernetes pod right-sizing','Idle resource auto-cleanup','Unified FinOps dashboard','Reserved instance intelligence','Multi-cloud cost allocation'].map(f => (
                <div style="display:flex;align-items:center;gap:10px;">
                  <div style="width:5px;height:5px;background:#0891B2;border-radius:50%;flex-shrink:0;"></div>
                  <span style="font-size:13.5px;font-weight:300;color:#4A5F72;">{f}</span>
                </div>
              ))}
            </div>
            <a href="/optix-ai" style="display:inline-block;background:#0891B2;color:#FAFAF8;font-size:13.5px;font-weight:500;padding:13px 32px;border-radius:6px;cursor:pointer;letter-spacing:.02em;text-decoration:none;">Explore Optix AI</a>
          </div>
          <div style="padding:48px;background:#F4F8FB;display:flex;flex-direction:column;justify-content:center;gap:28px;">
            <div>
              <div style="font-family:'Cormorant Garamond',serif;font-size:56px;font-weight:700;color:#0891B2;line-height:1;">43%</div>
              <div style="font-size:13px;font-weight:400;color:#5A7080;margin-top:4px;">Average cloud waste eliminated</div>
            </div>
            <div style="height:1px;background:#DDE8F0;"></div>
            <div>
              <div style="font-family:'Cormorant Garamond',serif;font-size:56px;font-weight:700;color:#0B1E30;line-height:1;">$436K</div>
              <div style="font-size:13px;font-weight:400;color:#5A7080;margin-top:4px;">Average annual savings per customer</div>
            </div>
            <div style="height:1px;background:#DDE8F0;"></div>
            <div>
              <div style="font-family:'Cormorant Garamond',serif;font-size:56px;font-weight:700;color:#0B1E30;line-height:1;">&lt;30m</div>
              <div style="font-size:13px;font-weight:400;color:#5A7080;margin-top:4px;">Time to deploy into your cloud</div>
            </div>
          </div>
        </div>
      </div>

      <!-- SRE + DriftGuard row -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
        <div style="border:1px solid #FDDCAA;border-radius:16px;padding:40px;background:#FFFDF8;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
            <div style="display:flex;align-items:center;gap:12px;">
              <div style="width:44px;height:44px;background:linear-gradient(135deg,#D97706,#F59E0B);border-radius:11px;display:flex;align-items:center;justify-content:center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="#fff" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="#fff"/></svg>
              </div>
              <div>
                <div style="font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:700;color:#0B1E30;">SRE Intelligence</div>
                <div style="font-size:12px;color:#9A7A50;font-weight:300;">Logs, stability &amp; reliability agent</div>
              </div>
            </div>
            <div style="background:#FFFBEB;border:1px solid #FDE68A;border-radius:20px;padding:5px 12px;">
              <span style="font-size:11px;font-weight:600;color:#D97706;text-transform:uppercase;letter-spacing:.06em;">Beta</span>
            </div>
          </div>
          <p style="font-size:14.5px;font-weight:300;line-height:1.75;color:#6A5A40;margin-bottom:28px;">An agent that lives inside your platform and continuously watches logs, traces, and metrics — surfacing anomalies before they become incidents.</p>
          <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:32px;">
            {['AI-powered log anomaly detection','Platform stability scoring & SLO tracking','Incident correlation & root-cause suggestions','Works with existing observability stack'].map(f => (
              <div style="display:flex;align-items:center;gap:10px;">
                <div style="width:5px;height:5px;background:#F59E0B;border-radius:50%;flex-shrink:0;"></div>
                <span style="font-size:13.5px;font-weight:300;color:#6A5A40;">{f}</span>
              </div>
            ))}
          </div>
          <a href="/sre-intelligence" style="display:inline-block;background:transparent;color:#D97706;font-size:13px;font-weight:500;padding:11px 24px;border:1.5px solid #F59E0B;border-radius:6px;text-decoration:none;">Join Beta</a>
        </div>

        <div style="border:1.5px dashed #C8D8E4;border-radius:16px;padding:40px;background:#F8FAFB;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
            <div style="display:flex;align-items:center;gap:12px;">
              <div style="width:44px;height:44px;background:#DDE8F0;border-radius:11px;display:flex;align-items:center;justify-content:center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><polyline points="17 1 21 5 17 9" stroke="#6A8EA0" stroke-width="1.8" stroke-linecap="round"/><path d="M3 11V9a4 4 0 0 1 4-4h14" stroke="#6A8EA0" stroke-width="1.8" stroke-linecap="round"/><polyline points="7 23 3 19 7 15" stroke="#6A8EA0" stroke-width="1.8" stroke-linecap="round"/><path d="M21 13v2a4 4 0 0 1-4 4H3" stroke="#6A8EA0" stroke-width="1.8" stroke-linecap="round"/></svg>
              </div>
              <div>
                <div style="font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:700;color:#6A8EA0;">DriftGuard</div>
                <div style="font-size:12px;color:#8AA0B0;font-weight:300;">Environment sync &amp; drift detection</div>
              </div>
            </div>
            <div style="background:#F1F5F9;border:1px solid #CBD5E1;border-radius:20px;padding:5px 12px;">
              <span style="font-size:11px;font-weight:600;color:#64748B;text-transform:uppercase;letter-spacing:.06em;">Coming Soon</span>
            </div>
          </div>
          <p style="font-size:14.5px;font-weight:300;line-height:1.75;color:#6A7E8A;margin-bottom:28px;">Solves the classic problem: it works in dev but breaks in prod. DriftGuard continuously compares configurations across environments and flags every divergence before it causes an outage.</p>
          <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:32px;">
            {['Dev / staging / prod config comparison','Secrets, env vars & infra drift alerts','Automated remediation suggestions','Kubernetes & Terraform state awareness'].map(f => (
              <div style="display:flex;align-items:center;gap:10px;">
                <div style="width:5px;height:5px;background:#94A3B8;border-radius:50%;flex-shrink:0;"></div>
                <span style="font-size:13.5px;font-weight:300;color:#6A7E8A;">{f}</span>
              </div>
            ))}
          </div>
          <a href="/driftguard" style="display:inline-block;background:transparent;color:#6A8EA0;font-size:13px;font-weight:500;padding:11px 24px;border:1.5px solid #C8D8E4;border-radius:6px;text-decoration:none;">Get Early Access</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ HOW IT WORKS ═══════ -->
  <section style="background:#0B1E30;padding:96px 0;">
    <div style="max-width:1440px;margin:0 auto;padding:0 72px;">
      <div style="margin-bottom:64px;">
        <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:18px;">
          <div style="width:20px;height:1px;background:#06B6D4;"></div>
          <span style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.14em;color:#06B6D4;">Deployment model</span>
        </div>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:52px;font-weight:600;letter-spacing:-.02em;color:#fff;line-height:1.08;">
          Agents that run in <em style="font-style:italic;color:#06B6D4;">your</em> infrastructure
        </h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;">
        <div style="position:absolute;top:27px;left:calc(12.5% + 18px);right:calc(12.5% + 18px);height:1px;background:rgba(255,255,255,.1);"></div>
        <div style="padding-right:40px;">
          <div style="width:56px;height:56px;border:1px solid rgba(255,255,255,.12);border-radius:50%;background:rgba(255,255,255,.05);display:flex;align-items:center;justify-content:center;margin-bottom:28px;position:relative;z-index:1;">
            <span style="font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:600;color:#06B6D4;">01</span>
          </div>
          <h3 style="font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:600;color:#fff;margin-bottom:10px;">Connect Your Cloud</h3>
          <p style="font-size:13.5px;font-weight:300;line-height:1.72;color:#6A8EA0;">We deploy a lightweight agent into your AWS, GCP, or Azure account using a read-write IAM role you control. No data leaves your perimeter.</p>
        </div>
        <div style="padding-right:40px;">
          <div style="width:56px;height:56px;border:1px solid rgba(255,255,255,.12);border-radius:50%;background:rgba(255,255,255,.05);display:flex;align-items:center;justify-content:center;margin-bottom:28px;position:relative;z-index:1;">
            <span style="font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:600;color:#06B6D4;">02</span>
          </div>
