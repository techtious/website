---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.tsx';
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="About Techtious Labs — Cloud Intelligence from Dehradun" description="We build autonomous cloud intelligence agents that deploy inside your infrastructure. Learn about our team and mission.">

  <Nav client:load />

  <!-- Hero -->
  <section class="section" style="position:relative;overflow:hidden;background:#FAFAF8;padding-bottom:80px;">
    <div class="dot-grid" style="position:absolute;inset:0;opacity:.38;pointer-events:none;"></div>
    <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#0891B2,#06B6D4 40%,transparent);"></div>
    <div class="wrap">
      <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:28px;">
        <div style="width:20px;height:1px;background:#0891B2;"></div>
        <span style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.14em;color:#0891B2;">About Techtious</span>
      </div>
      <div style="display:grid;grid-template-columns:1fr 480px;gap:96px;align-items:end;">
        <h1 class="h1-xl" style="margin-bottom:0;">
          We build products.<br>We ship what<br>we <em style="font-style:italic;color:#0891B2;">promise.</em>
        </h1>
        <div style="padding-bottom:8px;">
          <p style="font-size:17px;font-weight:300;line-height:1.75;color:#5A7080;margin-bottom:24px;">Techtious Labs is a cloud intelligence product company based in Dehradun, Uttarakhand, India. We build autonomous agents that deploy inside your cloud — reducing costs, catching drift, and keeping platforms stable.</p>
          <p style="font-size:15px;font-weight:300;line-height:1.75;color:#7A8EA0;">We're a small, focused team that goes all in for every customer we work with. We choose our partnerships carefully — because when we commit, we deliver completely.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section" style="background:#fff;">
    <div class="wrap">
      <div style="display:flex;align-items:baseline;justify-content:space-between;gap:32px;flex-wrap:wrap;margin-bottom:56px;">
        <div>
          <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:18px;">
            <div style="width:20px;height:1px;background:#0891B2;"></div>
            <span style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.14em;color:#0891B2;">The Team</span>
          </div>
          <h2 class="h2-lg">The people <em style="font-style:italic;color:#0891B2;">building this</em></h2>
        </div>
        <p style="font-size:14px;font-weight:300;color:#8AA0B0;max-width:280px;">More team members joining as we grow.</p>
      </div>

      <!-- Founder card -->
      <div style="display:grid;grid-template-columns:320px 1fr;border:1px solid #E2EAF0;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(11,30,48,.06);">
        <!-- Photo -->
        <div style="background:#EEF6FB;min-height:400px;overflow:hidden;">
          <img src={`${B}/rahul-lamba.jpg`} alt="Rahul Lamba" style="width:100%;height:100%;object-fit:cover;object-position:center top;display:block;" />
        </div>
        <!-- Details -->
        <div style="padding:52px 60px;display:flex;flex-direction:column;justify-content:center;">
          <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:20px;">
            <div style="width:20px;height:1px;background:#0891B2;"></div>
            <span style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.16em;color:#0891B2;">Founder</span>
          </div>
          <h3 style="font-family:'Cormorant Garamond',serif;font-size:48px;font-weight:600;color:#0B1E30;line-height:1.08;margin-bottom:20px;">Rahul Lamba</h3>
          <p style="font-size:15px;font-weight:300;line-height:1.8;color:#5A7080;max-width:520px;margin-bottom:28px;">Engineer turned founder. Built and operated cloud infrastructure at scale across AWS, GCP, and Azure before starting Techtious. Obsessed with making cloud systems intelligent and self-managing — so engineering teams spend their time building, not firefighting.</p>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px;">
            {['Cloud Architecture','Platform Engineering','Gen AI','SRE','FinOps'].map(tag => (
              <span style={`font-size:12px;font-weight:500;color:#0891B2;padding:4px 14px;border:1px solid #0891B228;border-radius:20px;background:#0891B20A;`}>{tag}</span>
            ))}
          </div>
          <a href="https://www.linkedin.com/in/connectwithrl/" target="_blank" rel="noopener"
            style="display:inline-flex;align-items:center;gap:8px;background:#0A66C2;color:#fff;font-size:13px;font-weight:500;padding:10px 22px;border-radius:6px;text-decoration:none;align-self:flex-start;letter-spacing:.02em;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#fff"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            Connect on LinkedIn
          </a>
        </div>
      </div>

      <!-- Future team placeholder -->
      <div style="margin-top:24px;border:1.5px dashed #DDE8F0;border-radius:16px;padding:48px;text-align:center;background:#FAFAF8;">
        <div style="width:48px;height:48px;background:#EEF6FB;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0891B2" stroke-width="1.8" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <p style="font-size:15px;font-weight:500;color:#0B1E30;margin-bottom:6px;">More team members coming soon</p>
        <p style="font-size:13px;font-weight:300;color:#8AA0B0;">We're hiring engineers who care about craft. <a href="https://cal.com/techtious/30min" target="_blank" rel="noopener" style="color:#0891B2;text-decoration:none;font-weight:400;">Talk to us →</a></p>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section style="background:#F4F7FA;padding:96px 0;border-top:1px solid #E2EAF0;">
    <div class="wrap">

      <!-- Section header -->
      <div style="display:flex;align-items:baseline;justify-content:space-between;gap:48px;margin-bottom:80px;padding-bottom:32px;border-bottom:1px solid #E2EAF0;flex-wrap:wrap;">
        <div>
          <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:18px;">
            <div style="width:20px;height:1px;background:#0891B2;"></div>
            <span style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.14em;color:#0891B2;">Core Values</span>
          </div>
          <h2 style="font-family:'Cormorant Garamond',serif;font-size:52px;font-weight:600;letter-spacing:-.02em;color:#0B1E30;line-height:1.08;">What we stand for</h2>
        </div>
        <p style="font-size:14px;font-weight:300;line-height:1.8;color:#5A7080;max-width:340px;">Five principles, lived every day. Real commitments that shape how we build, how we work, and who we are as a team.</p>
      </div>

    </div>

    <!-- Value 01 — image left, light -->
    <div style="display:grid;grid-template-columns:560px 1fr;max-width:1440px;margin:0 auto 3px;padding:0 72px;gap:0;border-radius:16px;overflow:hidden;">
      <div style="width:100%;height:420px;overflow:hidden;flex-shrink:0;border-radius:12px 0 0 12px;">
        <div style="width:100%;height:100%;background:linear-gradient(135deg,#EFF8FB 0%,#C8E6F0 50%,#A8D4E8 100%);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;">
          <svg viewBox="0 0 400 420" style="width:100%;height:100%;position:absolute;inset:0;opacity:.18;" fill="none"><circle cx="200" cy="210" r="180" stroke="#0891B2" stroke-width="1"/><circle cx="200" cy="210" r="130" stroke="#0891B2" stroke-width="1"/><circle cx="200" cy="210" r="80" stroke="#0891B2" stroke-width="1"/><line x1="20" y1="210" x2="380" y2="210" stroke="#0891B2" stroke-width=".8"/><line x1="200" y1="30" x2="200" y2="390" stroke="#0891B2" stroke-width=".8"/></svg>
          <div style="text-align:center;z-index:1;padding:32px;">
            <div style="font-family:'Cormorant Garamond',serif;font-size:64px;font-weight:700;color:#0891B2;opacity:.4;line-height:1;">01</div>
          </div>
        </div>
      </div>
      <div style="background:#FAFAF8;border:1px solid #E2EAF0;border-left:none;border-radius:0 12px 12px 0;padding:60px 64px;display:flex;flex-direction:column;justify-content:center;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:24px;">
          <span style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.18em;color:#0891B2;">Energetic</span>
          <div style="flex:1;height:1px;background:#E2EAF0;"></div>
          <span style="font-size:11px;font-weight:600;color:#C8D8E4;">01</span>
        </div>
        <h3 style="font-family:'Cormorant Garamond',serif;font-size:48px;font-weight:600;color:#0B1E30;line-height:1.06;margin-bottom:22px;">Pursuit of<br><em style="font-style:italic;color:#0891B2;">Excellence</em></h3>
        <p style="font-size:16px;font-weight:300;line-height:1.8;color:#5A7080;max-width:420px;">We push ourselves and each other toward better work, bigger impact, continuous growth. Good enough is never the goal.</p>
      </div>
    </div>

    <!-- Value 02 — image right, light -->
    <div style="display:grid;grid-template-columns:1fr 560px;max-width:1440px;margin:0 auto 3px;padding:0 72px;gap:0;overflow:hidden;">
      <div style="background:#FAFAF8;border:1px solid #E2EAF0;border-right:none;border-radius:12px 0 0 12px;padding:60px 64px;display:flex;flex-direction:column;justify-content:center;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:24px;">
          <span style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.18em;color:#0891B2;">Energetic</span>
          <div style="flex:1;height:1px;background:#E2EAF0;"></div>
          <span style="font-size:11px;font-weight:600;color:#C8D8E4;">02</span>
        </div>
        <h3 style="font-family:'Cormorant Garamond',serif;font-size:48px;font-weight:600;color:#0B1E30;line-height:1.06;margin-bottom:22px;">Pragmatic<br><em style="font-style:italic;color:#0891B2;">Problem Solving</em></h3>
        <p style="font-size:16px;font-weight:300;line-height:1.8;color:#5A7080;max-width:420px;">We ship solutions. We don't over-engineer or overthink. Results over process — always.</p>
      </div>
      <div style="width:100%;height:420px;overflow:hidden;flex-shrink:0;border-radius:0 12px 12px 0;">
        <div style="width:100%;height:100%;background:linear-gradient(225deg,#EFF8FB 0%,#BDD8E8 50%,#92C0D8 100%);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;">
          <svg viewBox="0 0 400 420" style="width:100%;height:100%;position:absolute;inset:0;opacity:.15;" fill="none"><rect x="40" y="40" width="320" height="340" stroke="#0891B2" stroke-width="1" rx="8"/><rect x="80" y="80" width="240" height="260" stroke="#0891B2" stroke-width="1" rx="6"/><rect x="120" y="120" width="160" height="180" stroke="#0891B2" stroke-width="1" rx="4"/></svg>
          <div style="text-align:center;z-index:1;padding:32px;">
            <div style="font-family:'Cormorant Garamond',serif;font-size:64px;font-weight:700;color:#0891B2;opacity:.4;line-height:1;">02</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Value 03 — image left, dark navy -->
    <div style="display:grid;grid-template-columns:560px 1fr;max-width:1440px;margin:0 auto 3px;padding:0 72px;gap:0;overflow:hidden;">
      <div style="width:100%;height:420px;overflow:hidden;flex-shrink:0;border-radius:12px 0 0 12px;">
        <div style="width:100%;height:100%;background:linear-gradient(135deg,#0B1E30 0%,#132D45 60%,#1A3D5C 100%);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;">
          <svg viewBox="0 0 400 420" style="width:100%;height:100%;position:absolute;inset:0;opacity:.12;" fill="none"><polygon points="200,30 370,380 30,380" stroke="#06B6D4" stroke-width="1"/><polygon points="200,80 320,340 80,340" stroke="#06B6D4" stroke-width="1"/><polygon points="200,130 270,300 130,300" stroke="#06B6D4" stroke-width="1"/></svg>
          <div style="text-align:center;z-index:1;padding:32px;">
            <div style="font-family:'Cormorant Garamond',serif;font-size:64px;font-weight:700;color:#06B6D4;opacity:.3;line-height:1;">03</div>
          </div>
        </div>
      </div>
      <div style="background:#0B1E30;border:1px solid #0E2840;border-left:none;border-radius:0 12px 12px 0;padding:60px 64px;display:flex;flex-direction:column;justify-content:center;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:24px;">
          <span style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.18em;color:#0891B2;">Discipline &amp; Consistency</span>
          <div style="flex:1;height:1px;background:rgba(255,255,255,.1);"></div>
          <span style="font-size:11px;font-weight:600;color:rgba(255,255,255,.2);">03</span>
        </div>
        <h3 style="font-family:'Cormorant Garamond',serif;font-size:48px;font-weight:600;color:#fff;line-height:1.06;margin-bottom:22px;">Integrity in<br><em style="font-style:italic;color:#06B6D4;">Commitment</em></h3>
        <p style="font-size:16px;font-weight:300;line-height:1.8;color:#8AADBE;max-width:420px;">We say what we do and do what we say. No empty promises. Accountability in every word.</p>
      </div>
    </div>

    <!-- Value 04 — image right, dark navy -->
    <div style="display:grid;grid-template-columns:1fr 560px;max-width:1440px;margin:0 auto 3px;padding:0 72px;gap:0;overflow:hidden;">
      <div style="background:#0B1E30;border:1px solid #0E2840;border-right:none;border-radius:12px 0 0 12px;padding:60px 64px;display:flex;flex-direction:column;justify-content:center;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:24px;">
          <span style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.18em;color:#0891B2;">Discipline &amp; Consistency</span>
          <div style="flex:1;height:1px;background:rgba(255,255,255,.1);"></div>
          <span style="font-size:11px;font-weight:600;color:rgba(255,255,255,.2);">04</span>
        </div>
        <h3 style="font-family:'Cormorant Garamond',serif;font-size:48px;font-weight:600;color:#fff;line-height:1.06;margin-bottom:22px;">Respect<br><em style="font-style:italic;color:#06B6D4;">Contributors</em></h3>
        <p style="font-size:16px;font-weight:300;line-height:1.8;color:#8AADBE;max-width:420px;">We build fairly. Everyone who works with us — team, contractors, partners — gets paid well, credited honestly, treated with dignity. No shortcuts on people.</p>
      </div>
      <div style="width:100%;height:420px;overflow:hidden;flex-shrink:0;border-radius:0 12px 12px 0;">
        <div style="width:100%;height:100%;background:linear-gradient(225deg,#0B1E30 0%,#0E2840 50%,#142E48 100%);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;">
          <svg viewBox="0 0 400 420" style="width:100%;height:100%;position:absolute;inset:0;opacity:.14;" fill="none">
            <circle cx="200" cy="210" r="140" stroke="#06B6D4" stroke-width="1"/>
            <circle cx="140" cy="210" r="80" stroke="#0891B2" stroke-width="1"/>
            <circle cx="260" cy="210" r="80" stroke="#0891B2" stroke-width="1"/>
          </svg>
          <div style="text-align:center;z-index:1;padding:32px;">
            <div style="font-family:'Cormorant Garamond',serif;font-size:64px;font-weight:700;color:#06B6D4;opacity:.3;line-height:1;">04</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Value 05 — image left, cyan-tinted -->
    <div style="display:grid;grid-template-columns:560px 1fr;max-width:1440px;margin:0 auto;padding:0 72px;gap:0;overflow:hidden;">
      <div style="width:100%;height:460px;overflow:hidden;flex-shrink:0;border-radius:12px 0 0 12px;">
        <div style="width:100%;height:100%;background:linear-gradient(135deg,#EFF8FB 0%,#D0EBF4 40%,#BDDFF0 100%);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;">
          <svg viewBox="0 0 400 460" style="width:100%;height:100%;position:absolute;inset:0;opacity:.2;" fill="none">
            <path d="M200 40 L360 420 L40 420 Z" stroke="#0891B2" stroke-width="1"/>
            <path d="M200 100 L320 400 L80 400 Z" stroke="#0891B2" stroke-width=".7"/>
            <line x1="40" y1="420" x2="360" y2="420" stroke="#0891B2" stroke-width="1"/>
            <line x1="200" y1="40" x2="200" y2="420" stroke="#0891B2" stroke-width=".7" stroke-dasharray="6 4"/>
          </svg>
          <div style="text-align:center;z-index:1;padding:32px;">
            <div style="font-family:'Cormorant Garamond',serif;font-size:64px;font-weight:700;color:#0891B2;opacity:.35;line-height:1;">05</div>
          </div>
        </div>
      </div>
      <div style="background:linear-gradient(135deg,#EFF8FB,#F0F7FF);border:1px solid #DDE8F0;border-left:none;border-radius:0 12px 12px 0;padding:64px;display:flex;flex-direction:column;justify-content:center;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:24px;">
          <span style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.18em;color:#0891B2;">Customer Needs</span>
          <div style="flex:1;height:1px;background:#DDE8F0;"></div>
          <span style="font-size:11px;font-weight:600;color:#C8D8E4;">05</span>
        </div>
        <h3 style="font-family:'Cormorant Garamond',serif;font-size:52px;font-weight:600;color:#0B1E30;line-height:1.04;margin-bottom:22px;">Customer-Centric<br><em style="font-style:italic;color:#0891B2;">Delivery</em></h3>
        <p style="font-size:16px;font-weight:300;line-height:1.8;color:#5A7080;max-width:480px;margin-bottom:28px;">We know who we serve and what they actually need. We respect their time by shipping lean, focused solutions. We only commit to customers we can deliver for — not every deal is worth taking.</p>
        <div style="display:flex;align-items:center;gap:10px;padding-top:24px;border-top:1px solid #DDE8F0;">
          <div style="width:6px;height:6px;background:#0891B2;border-radius:50%;flex-shrink:0;"></div>
          <span style="font-size:13.5px;font-weight:500;color:#0891B2;font-style:italic;">"Not every deal is worth taking."</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Location strip -->
  <section class="section-sm" style="background:#F4F7FA;border-top:1px solid #E2EAF0;">
    <div class="wrap">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:48px;flex-wrap:wrap;">
        <div>
          <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.14em;color:#8AA0B0;margin-bottom:12px;">Registered in</div>
          <div style="font-family:'Cormorant Garamond',serif;font-size:36px;font-weight:600;color:#0B1E30;line-height:1.1;">Dehradun, Uttarakhand</div>
          <div style="font-size:13.5px;font-weight:300;color:#8AA0B0;margin-top:6px;">India · Operating across UAE &amp; beyond</div>
        </div>
        <div style="display:flex;gap:48px;flex-wrap:wrap;">
          <div>
            <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:#8AA0B0;margin-bottom:8px;">Reach us</div>
            <a href="mailto:sales@techtious.com" style="font-size:15px;color:#0891B2;text-decoration:none;font-weight:400;">sales@techtious.com</a>
          </div>
          <div>
            <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:#8AA0B0;margin-bottom:8px;">Follow</div>
            <div style="display:flex;gap:16px;">
              <a href="https://www.linkedin.com/company/techtious" target="_blank" rel="noopener" style="font-size:14px;font-weight:500;color:#4A5F72;text-decoration:none;">LinkedIn</a>
              <a href="https://github.com/techtious" target="_blank" rel="noopener" style="font-size:14px;font-weight:500;color:#4A5F72;text-decoration:none;">GitHub</a>
            </div>
          </div>
        </div>
        <a href="https://cal.com/techtious/30min" target="_blank" rel="noopener" style="background:#0891B2;color:#FAFAF8;font-size:13px;font-weight:500;padding:13px 28px;border-radius:5px;text-decoration:none;letter-spacing:.02em;flex-shrink:0;">Book a Free Consultation</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer style="background:#0B1E30;padding:64px 0 0;">
    <div class="wrap" style="padding-top:0;">
      <div class="grid-footer" style="padding-bottom:40px;border-bottom:1px solid rgba(255,255,255,.08);">
        <div>
          <div style="font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:600;color:#fff;margin-bottom:14px;">Techtious Labs</div>
          <p style="font-size:13.5px;font-weight:300;line-height:1.7;color:#6A8EA0;max-width:240px;margin-bottom:16px;">Cloud intelligence agents. Dehradun, Uttarakhand, India.</p>
          <a href="mailto:sales@techtious.com" style="font-size:13px;color:#0891B2;text-decoration:none;">sales@techtious.com</a>
        </div>
        <div>
          <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:#4A6878;margin-bottom:18px;">Products</div>
          <div style="display:flex;flex-direction:column;gap:12px;">
            <a href={`${B}/optix-ai`} style="font-size:13.5px;color:#7AACBE;text-decoration:none;font-weight:300;">Optix AI</a>
            <a href={`${B}/sre-intelligence`} style="font-size:13.5px;color:#7AACBE;text-decoration:none;font-weight:300;">SRE Intelligence</a>
            <a href={`${B}/driftguard`} style="font-size:13.5px;color:#7AACBE;text-decoration:none;font-weight:300;">DriftGuard</a>
          </div>
        </div>
