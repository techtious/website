---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.tsx';
---
<Base title="DriftGuard — Environment Sync & Drift Detection | Techtious Labs" description="An agent that continuously compares your dev, staging, and prod configurations — flagging every divergence before it causes an outage.">

  <Nav client:load />

  <!-- Hero -->
  <section class="section" style="position:relative;overflow:hidden;background:#FAFAF8;">
    <div class="dot-grid" style="position:absolute;inset:0;opacity:.35;pointer-events:none;"></div>
    <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#3B82F6,#60A5FA 50%,transparent);"></div>
    <div class="wrap">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:24px;flex-wrap:wrap;">
        <div style="width:40px;height:40px;background:#DDE8F0;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><polyline points="17 1 21 5 17 9" stroke="#3B82F6" stroke-width="2" stroke-linecap="round"/><path d="M3 11V9a4 4 0 0 1 4-4h14" stroke="#3B82F6" stroke-width="2" stroke-linecap="round"/><polyline points="7 23 3 19 7 15" stroke="#3B82F6" stroke-width="2" stroke-linecap="round"/><path d="M21 13v2a4 4 0 0 1-4 4H3" stroke="#3B82F6" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
          <span style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.14em;color:#3B82F6;">DriftGuard</span>
          <span style="font-size:10px;font-weight:600;color:#64748B;background:#F1F5F9;border:1px solid #CBD5E1;padding:2px 8px;border-radius:10px;text-transform:uppercase;letter-spacing:.06em;">Coming Soon</span>
        </div>
      </div>
      <div class="hero-grid-mid">
        <div>
          <h1 class="h1-lg" style="color:#0B1E30;">
            It works in dev.<br>Keep it that way<br>in <em style="font-style:italic;color:#3B82F6;">production</em>
          </h1>
          <p style="font-size:17px;font-weight:300;line-height:1.75;color:#5A7080;max-width:500px;margin-bottom:36px;">DriftGuard continuously compares configurations across your environments. Every divergence is flagged before it causes an outage. Env vars, secrets, Kubernetes manifests, Terraform state — nothing slips through.</p>
          <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
            <a href="https://cal.com/techtious/30min" target="_blank" rel="noopener" style="display:inline-block;background:#3B82F6;color:#FAFAF8;font-size:13.5px;font-weight:500;padding:14px 36px;border-radius:5px;text-decoration:none;letter-spacing:.02em;">Get early access</a>
            <span style="font-size:13px;font-weight:300;color:#8AA0B0;">No commitment required</span>
          </div>
        </div>
        <!-- Problem/solution panel -->
        <div style="display:flex;flex-direction:column;gap:16px;">
          <div style="background:#FEF2F2;border:1px solid #FECACA;border-radius:12px;padding:24px;">
            <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:#DC2626;margin-bottom:10px;">Without DriftGuard</div>
            <div style="display:flex;flex-direction:column;gap:8px;">
              {['"Works on my machine" becomes a prod outage','Secret rotated in dev, forgotten in prod','Terraform state diverges silently for weeks','On-call spends 3 hours on config archaeology'].map(p => (
                <div style="display:flex;align-items:flex-start;gap:8px;">
                  <span style="color:#DC2626;font-size:14px;flex-shrink:0;margin-top:1px;">✕</span>
                  <span style="font-size:13px;font-weight:300;color:#6A3030;line-height:1.5;">{p}</span>
                </div>
              ))}
            </div>
          </div>
          <div style="background:#EFF6FF;border:1px solid #BFDBFE;border-radius:12px;padding:24px;">
            <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:#2563EB;margin-bottom:10px;">With DriftGuard</div>
            <div style="display:flex;flex-direction:column;gap:8px;">
              {['Drift detected the moment it happens, not after','Every env diff explained and ranked by blast radius','Automated remediation for approved drift patterns','Deploy with confidence — environments are in sync'].map(p => (
                <div style="display:flex;align-items:flex-start;gap:8px;">
                  <span style="color:#2563EB;font-size:14px;flex-shrink:0;margin-top:1px;">✓</span>
                  <span style="font-size:13px;font-weight:300;color:#1E3A5F;line-height:1.5;">{p}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Planned capabilities -->
  <section class="section" style="background:#fff;">
    <div class="wrap">
      <div style="margin-bottom:48px;">
        <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:18px;">
          <div style="width:20px;height:1px;background:#3B82F6;"></div>
          <span style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.14em;color:#3B82F6;">Planned capabilities</span>
        </div>
        <h2 class="h2-lg">What DriftGuard will <em style="font-style:italic;color:#3B82F6;">watch</em></h2>
      </div>
      <div class="grid-3">
        {[
          { title:'Env Var & Secret Comparison', body:'Compare environment variables and secret references across dev, staging, and prod. Flag any key present in one environment but missing or different in another.' },
          { title:'Kubernetes Manifest Diffing', body:'Continuously compare deployed manifests against your source of truth — Helm values, Kustomize overlays, or raw YAML. Surface every undocumented change.' },
          { title:'Terraform State Awareness', body:'Watch your Terraform state files for drift between what was planned and what is actually deployed. Alert before unmanaged changes accumulate.' },
          { title:'Config & Feature Flag Sync', body:'Track application configuration across environments — including feature flag states. Ensure that what shipped to staging is what ships to prod.' },
          { title:'Blast-Radius Scoring', body:'Not all drift is equal. DriftGuard scores each divergence by potential impact — a missing env var for a payment service ranks higher than a log-level difference.' },
          { title:'Automated Remediation', body:'For approved drift patterns, DriftGuard can apply the fix automatically — syncing the lagging environment to match the source of truth, with full audit logging.' },
        ].map(c => (
          <div style="border:1.5px dashed #BFDBFE;border-radius:12px;padding:28px;background:#F8FBFF;">
            <div style="width:36px;height:3px;background:linear-gradient(90deg,#3B82F6,#60A5FA);border-radius:2px;margin-bottom:18px;"></div>
            <h3 style="font-family:'Cormorant Garamond',serif;font-size:21px;font-weight:600;color:#0B1E30;margin-bottom:10px;">{c.title}</h3>
            <p style="font-size:13.5px;font-weight:300;line-height:1.75;color:#5A7080;">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" style="background:#0B1E30;text-align:center;">
    <div class="wrap">
      <div style="display:inline-flex;align-items:center;gap:8px;margin-bottom:18px;">
        <div style="width:20px;height:1px;background:#60A5FA;"></div>
        <span style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.14em;color:#60A5FA;">Early access</span>
        <div style="width:20px;height:1px;background:#60A5FA;"></div>
      </div>
      <h2 class="h2-xl h2-white" style="margin-bottom:16px;">Shape DriftGuard<br>before it <em style="font-style:italic;color:#60A5FA;">ships</em></h2>
      <p style="font-size:15px;font-weight:300;line-height:1.75;color:#6A8EA0;max-width:480px;margin:0 auto 36px;">We're collecting early access requests now. Early access customers influence the roadmap directly.</p>
      <a href="https://cal.com/techtious/30min" target="_blank" rel="noopener" style="display:inline-block;background:#3B82F6;color:#FAFAF8;font-size:14px;font-weight:500;padding:15px 44px;border-radius:5px;text-decoration:none;letter-spacing:.02em;">Request early access</a>
    </div>
  </section>

  <!-- Footer -->
  <footer style="background:#0B1E30;padding:64px 0 0;border-top:1px solid rgba(255,255,255,.06);">
    <div class="wrap" style="padding-top:0;">
      <div class="grid-footer" style="padding-bottom:40px;border-bottom:1px solid rgba(255,255,255,.08);">
        <div>
          <div style="font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:600;color:#fff;margin-bottom:14px;">Techtious Labs</div>
          <a href="mailto:sales@techtious.com" style="font-size:13px;color:#0891B2;text-decoration:none;">sales@techtious.com</a>
        </div>
        <div>
          <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:#4A6878;margin-bottom:18px;">Products</div>
          <div style="display:flex;flex-direction:column;gap:12px;">
            <a href="/optix-ai" style="font-size:13.5px;color:#7AACBE;text-decoration:none;font-weight:300;">Optix AI</a>
            <a href="/sre-intelligence" style="font-size:13.5px;color:#7AACBE;text-decoration:none;font-weight:300;">SRE Intelligence</a>
            <a href="/driftguard" style="font-size:13.5px;color:#60A5FA;text-decoration:none;font-weight:400;">DriftGuard</a>
          </div>
        </div>
        <div>
          <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:#4A6878;margin-bottom:18px;">Services</div>
          <div style="display:flex;flex-direction:column;gap:12px;">
            {['Cloud Engineering','Platform Engineering','Gen AI Solutions','Observability & SRE'].map(s => (
              <a style="font-size:13.5px;color:#7AACBE;text-decoration:none;font-weight:300;">{s}</a>
            ))}
          </div>
        </div>
        <div>
          <a href="https://cal.com/techtious/30min" target="_blank" rel="noopener" style="display:inline-block;background:#0891B2;color:#FAFAF8;font-size:13px;font-weight:500;padding:13px 28px;border-radius:5px;text-decoration:none;">Book a Consultation</a>
        </div>
      </div>
      <div style="padding:20px 0;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;">
        <span style="font-size:12.5px;color:#3D5A6A;">© 2026 Techtious Labs. All rights reserved.</span>
        <span style="font-size:12.5px;color:#3D5A6A;">Dehradun, Uttarakhand, India</span>
      </div>
    </div>
  </footer>

</Base>
