---
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.tsx';
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Techtious Labs', description = 'Cloud intelligence agents that deploy inside your infrastructure.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
  <ChatWidget client:load />
</body>
</html>
